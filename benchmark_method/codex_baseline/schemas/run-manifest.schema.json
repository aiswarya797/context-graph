  "type": "object",
  "required": ["run_id", "arm", "protocol", "configuration", "corpus", "evaluator"],
  "properties": {
    "run_id": {"type": "string"},
    "arm": {"const": "codex-baseline"},
    "protocol": {"const": "direct-region-v1"},
    "configuration": {"type": "object"},
    "corpus": {"type": "object"},
    "evaluator": {"type": "object"}
  }
}
